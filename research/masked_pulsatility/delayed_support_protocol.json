  "primary_covariates": ["age","male_sex","sbp_anchor","map_anchor","hr_anchor","sbp_slope_2h","map_slope_2h","hr_slope_2h","prior_prpp","resp_rate_anchor","spo2_anchor","creatinine_preanchor_24h","bp_measurement_count_4h","anchor_hour"],
